SERVER_ADDR=:8080
DATABASE_URL=postgres://gpt_monitor_ro:REPLACE_DB_PASSWORD@sub2api-postgres:5432/sub2api?sslmode=disable
MONITOR_ADMIN_USERNAME=gptpro-admin
MONITOR_ADMIN_PASSWORD_HASH=REPLACE_BCRYPT_HASH
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL=12h
COOKIE_SECURE=true
CACHE_TTL=60s
USAGE_STALE_AFTER=60m
USAGE_WARNING_THRESHOLD=90
EXPIRY_CRITICAL_DAYS=3
EXPIRY_WARNING_DAYS=7
EXPIRY_ATTENTION_DAYS=14
EXPIRY_UPCOMING_DAYS=30
SUB2API_ADMIN_URL=https://sgapi.lmuai.ai/admin/accounts
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
SHUTDOWN_TIMEOUT=10s

# ---------- Codex 292 打票看板 ----------
# 关掉后相关路由返回 404，前端不显示这个标签页。
CODEX_DASHBOARD_ENABLED=true
# 门控模型的兜底清单（逗号分隔）。正常情况看板直接读 sub2api 的 openai_codex_ticket_models，
# 只有 settings 读不到时才用这里的值。
CODEX_GATED_MODELS=gpt-6-astra
# 参与分池统计的分组 ID，逗号分隔。205 上 8=gpt-pro-pool-1、6=gpt-pro-pool-2-auto
# （46 上是 67、69；两边不是同一个库，换库一定要重查 groups 表）。
CODEX_POOL_GROUP_IDS=8,6
# 「按天趋势」的日边界时区。不设的话日桶会跟着数据库会话时区走。
CODEX_DISPLAY_TIMEZONE=Asia/Shanghai

# 下面四个 TTL 就是对数据库的性能预算旋钮（实测值见 README「对数据库的压力」）。
# 票池查询 ~15ms、零磁盘读。
CODEX_POOL_CACHE_TTL=60s
# 用量聚合 ~18-35ms，一次扫描出逐账号/逐小时/总计三层。最小 30s。
CODEX_USAGE_CACHE_TTL=120s
# 7 天按天趋势 ~370ms 且要读约 280MB 数据页，只在前端点击时才跑。最小 5m。
CODEX_TREND_CACHE_TTL=30m
# 持票数趋势的采样节拍（只打票池那条便宜查询）。最小 30s。
CODEX_SAMPLE_INTERVAL=2m
CODEX_TREND_RETENTION=24h
# 用量窗口上限 24 小时：再长就必须读堆页，会挤掉 sub2api 的热缓存。
CODEX_USAGE_WINDOW_HOURS=24
CODEX_TREND_DAYS=7

# 数据库护栏：单条查询超时 + 连接数上限，保证监控永远压不垮 sub2api 的 Postgres。
DB_STATEMENT_TIMEOUT=8s
DB_MAX_CONNS=4

# ---------- 智商检测 ----------
# 定时抽一部分可用号（默认 10%、至少 2 个，看板「设置」里可改）答一道糖果题（标准答案 21，要求 JSON 作答），按答对率衡量每个号的答题水平。
# 唯一会调用上游、也唯一会写数据的模块：经 sub2api 管理员测试接口发题（probe 模式：不清账号冷却状态、不写审计），
# 结果写在下面这个 SQLite 文件里。sub2api 的库仍然只读。
IQ_ENABLED=false
# 监控容器内网访问 sub2api（当前活跃槽位的容器名）
SUB2API_BASE_URL=http://sub2api-blue:8080
# sub2api 管理员 API Key（x-api-key）。这是全权凭证：只放在这个文件里，不会出现在任何接口响应和日志里。
SUB2API_ADMIN_API_KEY=
IQ_DB_PATH=/data/iq.db
# 低于这个版本的 sub2api 测试接口会把题目换成 "hi"，监控会一直停在「等待 sub2api 支持」。
IQ_MIN_SUB2API_VERSION=lmuai-0.2.13.2
# 测试模型的初始清单（之后以看板「设置」里保存的为准）：模型@推理强度，逗号分隔。
IQ_DEFAULT_MODELS=gpt-6-astra@xhigh
# 检测周期与随机范围的默认值。看板「设置」里保存过定时配置之后以界面为准，这两项不再生效。
# 随机范围最多是周期的一半。
IQ_INTERVAL=5m
IQ_JITTER=60s
IQ_CONCURRENCY=2
# xhigh/max 推理单次可能要几分钟
IQ_REQUEST_TIMEOUT=4m
IQ_RETENTION=2160h
# 门控模型按网关同一套规则注入 292 票，测到的是真实用户拿到的那种请求
IQ_APPLY_CODEX_TICKET=true
# 判级：最近 IQ_RECENT_WINDOW 次可判分结果，≥ HEALTHY 正常、< WARNING 降智，样本少于 IQ_MIN_SAMPLES 不下结论
IQ_HEALTHY_PERCENT=80
IQ_WARNING_PERCENT=50
IQ_RECENT_WINDOW=30
IQ_MIN_SAMPLES=5

# ---------- 智商检测：第三方供应商 ----------
# 看板「智商检测 → 第三方」里添加任意 OpenAI 兼容接口（Base URL + API Key），各自独立的检测周期与测试模型，
# 和号池同一道题、同一套判分，在「号池 vs 第三方」里对比。
IQ_PROVIDERS_ENABLED=true
# 第三方 API Key 的加密密钥（AES-GCM，至少 16 字符）。不设时用 SESSION_SECRET 派生。
# 换了这个值（或没设时换了 SESSION_SECRET），已存的 Key 解不开，需要在界面上重填。
IQ_SECRET_KEY=
# 默认拒绝 Base URL 指向内网 / 回环 / 云元数据地址，防止被当成探测内网的跳板。只在测试时打开。
IQ_PROVIDER_ALLOW_PRIVATE=false
